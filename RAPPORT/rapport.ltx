    \begin{tikzpicture}[
        neuron/.style={circle, draw=myblue, thick, fill=white, minimum size=9mm},
        connection/.style={draw=black!20, thin}
    ]
        % Couche d'entrée
        \foreach \i in {1,2,3} {
            \node[neuron] (I\i) at (0, -\i) {};
        }
        % Couche cachée 1
        \foreach \i in {1,2,3,4} {
            \node[neuron] (H1\i) at (3, -\i+0.5) {};
        }
        % Couche cachée 2
        \foreach \i in {1,2,3,4} {
            \node[neuron] (H2\i) at (6, -\i+0.5) {};
        }
        % Couche de sortie
        \foreach \i in {1,2} {
            \node[neuron] (O\i) at (9, -\i-0.5) {};
        }

        % Connexions Entrée -> Cachée 1
        \foreach \i in {1,2,3} {
            \foreach \j in {1,2,3,4} {
                \draw[connection] (I\i) -- (H1\j);
            }
        }
        % Connexions Cachée 1 -> Cachée 2
        \foreach \i in {1,2,3,4} {
            \foreach \j in {1,2,3,4} {
                \draw[connection] (H1\i) -- (H2\j);
            }
        }
        % Connexions Cachée 2 -> Sortie
        \foreach \i in {1,2,3,4} {
            \foreach \j in {1,2} {
                \draw[connection] (H2\i) -- (O\j);
            }
        }
    \end{tikzpicture}
    
